{
    "APP": {
        "minHeight": "100vh",
        "display": "flex",
        "flexDirection": "column",
        "backgroundColor": "#f8f9fa",
        "userSelect": "none"
    },
    "HEADER": {
        "minHeight": "72px",
        "backgroundColor": "#ffffff",
        "borderBottom": "1px solid #e9ecef",
        "boxShadow": "0 2px 8px rgba(0, 0, 0, 0.03)",
        "display": "flex",
        "alignItems": "center",
        "padding": "0 1rem",
        "position": "sticky",
        "top": "0",
        "zIndex": 1030
    },
    "MAIN": {
        "flex": "1",
        "overflow": "auto",
        "padding": "1.5rem 0"
    },
    "FOOTER": {
        "backgroundColor": "#212529",
        "borderTop": "1px solid #343a40",
        "padding": "0.9rem 0"
    }
}